# Required authentication. FYERS access tokens normally need to be refreshed daily.
FYERS_APP_ID=app-id
FYERS_ACCESS_TOKEN=token


# Alternative to the two variables above:
# FYERS_WS_TOKEN=YOUR_APP_ID-100:YOUR_DAILY_ACCESS_TOKEN

# Required exact FYERS symbols. Comma-separated or a JSON list.
FYERS_SYMBOLS=NSE:RELIANCE

# FYERS TBT channel, valid range 1..50.
FYERS_TBT_CHANNEL=1

# Output and logging.
TICKRECORDER_DATA_DIR=data
TICKRECORDER_LOG_DIR=logs
TICKRECORDER_SDK_LOG_DIR=logs/fyers-sdk
TICKRECORDER_LOG_LEVEL=INFO
TICKRECORDER_TIMEZONE=Asia/Kolkata

# Immutable Parquet part-file rotation.
TICKRECORDER_FLUSH_INTERVAL_SECONDS=60
TICKRECORDER_MAX_ROWS_PER_FILE=5000
TICKRECORDER_PARQUET_COMPRESSION=zstd

# Callback queue. Queue exhaustion is fatal; events are never silently dropped.
TICKRECORDER_QUEUE_MAX_EVENTS=50000
TICKRECORDER_QUEUE_PUT_TIMEOUT_SECONDS=2

# Socket reconnect behavior.
TICKRECORDER_DATA_RECONNECT=true
TICKRECORDER_DATA_RECONNECT_RETRIES=20
TICKRECORDER_TBT_RECONNECT=true
TICKRECORDER_TBT_RECONNECT_RETRIES=20
TICKRECORDER_CONNECT_TIMEOUT_SECONDS=15
TICKRECORDER_REQUIRE_FIRST_EVENT=true
TICKRECORDER_FIRST_EVENT_TIMEOUT_SECONDS=30
TICKRECORDER_DISCONNECT_GRACE_SECONDS=30
TICKRECORDER_STALE_FEED_TIMEOUT_SECONDS=60
TICKRECORDER_SHUTDOWN_TIMEOUT_SECONDS=20

# Operational status and optional finite run duration.
TICKRECORDER_STATUS_INTERVAL_SECONDS=10
TICKRECORDER_DURATION_SECONDS=0

# Depth arrays are already stored structurally. Enabling this duplicates them as JSON.
TICKRECORDER_INCLUDE_DEPTH_RAW_JSON=false
